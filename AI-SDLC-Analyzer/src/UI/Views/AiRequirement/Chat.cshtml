<link rel="stylesheet" href="~/css/aichat.css" asp-append-version="true" />

<div class="container mt-4">
    <h2 class="text-center">🤖 AI-SDLC Requirement Chatbot</h2>

    <div id="chat-box" class="chat-box">
        <div class="message bot">
            <span>Hi! How can I help you with SDLC requirements today? 😊</span>
        </div>
    </div>

    <div class="chat-options">
        <div class="option-group-inline">
            <label for="model-select">🔍 Model:</label>
            <select id="model-select">
                <option value="all-MiniLM-L6-v2" selected>MiniLM (default)</option>
                <option value="all-mpnet-base-v2">MPNet</option>
            </select>
        </div>

        <div class="option-group-inline">
            <label for="method-select">🧠 Method:</label>
            <select id="method-select">
                <option value="cosine" selected>Cosine Similarity</option>
                <option value="faiss">FAISS</option>
            </select>
        </div>
    </div>

    <div class="chat-input">
        <input type="text" id="user-input" placeholder="Type your query about SDLC requirements..." oninput="expandInput()" />
        <button onclick="sendMessage()">Send</button>
        <button onclick="clearChat()" class="clear-btn">🗑 Clear</button>
    </div>
</div>

<script src="~/js/enhanced-chat.js" asp-append-version="true"></script>