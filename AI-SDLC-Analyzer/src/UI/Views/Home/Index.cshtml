@{
    ViewData["Title"] = "Home Page";
}

<link rel="stylesheet" href="~/css/mainscreen.css" asp-append-version="true" />

<!-- Background Animation Elements -->
<ul class="bg-animation">
    <li></li>
    <li></li>
    <li></li>
    <li></li>
    <li></li>
    <li></li>
    <li></li>
    <li></li>
    <li></li>
    <li></li>
</ul>

<div class="hero-container">
    <div class="content-wrapper">
        <h1 class="animated-heading display-4">Welcome to HCLTech</h1>
        <p class="lead">Empowering Innovation with AI-driven Software Development Lifecycle Analysis.</p>

        <hr class="my-4">

        <!-- Feature Icons -->
        <div class="features-wrapper">
            <div class="feature-item">
                <div class="feature-icon">⚡</div>
                <h4>Rapid Analysis</h4>
                <p>Process complex requirements in seconds using advanced AI algorithms</p>
            </div>
            <div class="feature-item">
                <div class="feature-icon">🔍</div>
                <h4>Deep Insights</h4>
                <p>Discover hidden patterns and relationships within your SDLC documentation</p>
            </div>
            <div class="feature-item">
                <div class="feature-icon">📈</div>
                <h4>Enhanced Efficiency</h4>
                <p>Streamline development processes and reduce requirement ambiguities</p>
            </div>
        </div>

        <p class="mt-4 mb-0">Introducing <strong>AI SDLC Analyzer</strong> – your intelligent assistant for analyzing and refining software development requirements efficiently.</p>

        <!-- Animated Gradient Button -->
        <div class="gradient-button-wrapper">
            <a class="gradient-button pulse" asp-area="" asp-controller="AiRequirement" asp-action="Chat">
                <span class="rocket">🚀</span> Launch AI SDLC Analyzer
            </a>
        </div>

        <p class="footer-text text-center">Developed by HCLTech to enhance SDLC efficiency and precision.</p>
    </div>
</div>

<!-- Add JavaScript for additional interactions -->
<script>
    document.addEventListener('DOMContentLoaded', function() {
        // Stopping animation on lower-powered devices
        const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
        if (prefersReducedMotion.matches) {
            document.querySelectorAll('.bg-animation').forEach(elem => {
                elem.style.display = 'none';
            });
        }

        // Add hover effect to the entire content area
        const contentWrapper = document.querySelector('.content-wrapper');
        contentWrapper.addEventListener('mousemove', function(e) {
            const rect = contentWrapper.getBoundingClientRect();
            const x = e.clientX - rect.left;
            const y = e.clientY - rect.top;

            const xPercent = (x / rect.width - 0.5) * 5;
            const yPercent = (y / rect.height - 0.5) * 5;

            contentWrapper.style.transform = `perspective(1000px) rotateX(${-yPercent}deg) rotateY(${xPercent}deg)`;
        });

        contentWrapper.addEventListener('mouseleave', function() {
            contentWrapper.style.transform = 'perspective(1000px) rotateX(0) rotateY(0)';
        });

        // Button click effect
        const button = document.querySelector('.gradient-button');
        button.addEventListener('mousedown', function() {
            this.style.transform = 'translateY(-2px) scale(1.02)';
        });

        button.addEventListener('mouseup', function() {
            this.style.transform = 'translateY(-5px) scale(1.05)';
        });
    });
</script>

