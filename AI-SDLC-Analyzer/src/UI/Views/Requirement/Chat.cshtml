@{
    ViewData["Title"] = "AI-SDLC Chatbot";
}
<link rel="stylesheet" href="~/css/chat.css" asp-append-version="true" />

<div class="container mt-4">
    <h2 class="text-center">🤖 AI-SDLC Requirement Chatbot</h2>

    <div id="chat-box" class="chat-box">
        <div class="message bot">
            <span>Hi! How can I help you with SDLC requirements today? 😊</span>
        </div>
    </div>

    <div class="chat-input">
        <input type="text" id="user-input" placeholder="Type your query..." />
        <button onclick="sendMessage()">Send</button>
    </div>
</div>


<script>
    function sendMessage() {
        let userInput = document.getElementById("user-input").value;
        if (!userInput.trim()) return;

        let chatBox = document.getElementById("chat-box");
        let inputField = document.getElementById("user-input");
        let sendButton = document.querySelector(".chat-input button");

        // Disable input & button
        inputField.disabled = true;
        sendButton.disabled = true;

        // Append user message
        let userMessage = document.createElement("div");
        userMessage.classList.add("message", "user");
        userMessage.innerHTML = `<span>${userInput}</span>`;
        chatBox.appendChild(userMessage);

        // Show animated typing indicator
        let typingIndicator = document.createElement("div");
        typingIndicator.classList.add("message", "bot", "typing-indicator");
        typingIndicator.innerHTML = `<span>🤖 Typing<span class="dots"></span></span>`;
        chatBox.appendChild(typingIndicator);
        chatBox.scrollTop = chatBox.scrollHeight;

        // Send API request
        fetch("/Requirement/ChatQuery", {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify({ query: userInput })
        })
            .then(response => response.json())
            .then(data => {
                chatBox.removeChild(typingIndicator); // Remove typing indicator

                if (data.error) {
                    let errorMessage = document.createElement("div");
                    errorMessage.classList.add("message", "bot");
                    errorMessage.innerHTML = `<span>⚠️ ${data.error}</span>`;
                    chatBox.appendChild(errorMessage);
                } else {
                    data.forEach((req, index) => {
                        setTimeout(() => {
                            let responseMessage = document.createElement("div");
                            responseMessage.classList.add("message", "bot");
                            responseMessage.innerHTML = `
                            <strong>📌 ${req.requirementDescription}</strong><br>
                            <strong>Category:</strong> ${req.category}<br>
                        `;
                            chatBox.appendChild(responseMessage);
                            chatBox.scrollTop = chatBox.scrollHeight;

                            // Display Change in Requirements one by one
                            req.changeInRequirement.forEach((change, i) => {
                                setTimeout(() => {
                                    let changeMessage = document.createElement("div");
                                    changeMessage.classList.add("message", "bot");
                                    changeMessage.innerHTML = `🔹 ${change}`;
                                    chatBox.appendChild(changeMessage);
                                    chatBox.scrollTop = chatBox.scrollHeight;
                                }, (i + 1) * 800); // Typing delay for each change
                            });

                        }, index * 2000); // Typing delay for each requirement
                    });
                }
            })
            .catch(() => {
                chatBox.removeChild(typingIndicator);
                let errorMessage = document.createElement("div");
                errorMessage.classList.add("message", "bot");
                errorMessage.innerHTML = `<span>⚠️ Unable to process request. Please try again later.</span>`;
                chatBox.appendChild(errorMessage);
            })
            .finally(() => {
                inputField.value = ""; // Clear input
                inputField.disabled = false;
                sendButton.disabled = false;
                inputField.focus(); // Auto-focus input
            });
    }
</script>




